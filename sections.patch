+    /* ---------- Sections ---------- */
+
+    function openSection(id) {
+      secEditing = id ?? null;
+
+      const section = secEditing !== null
+        ? db.sections.find(item => item.id === secEditing)
+        : null;
+
+      $('secf-title').textContent = section
+        ? `Edit Section: ${section.name}`
+        : 'Add New Section';
+
+      $('secf-name').value = section ? section.name : '';
+
+      $('secf-adviser').innerHTML =
+        '<option value="">No adviser</option>' +
+        db.users
+          .filter(person =>
+            isApproved(person) && person.role === 'faculty'
+          )
+          .map(faculty => `
+            <option
+              value="${Number(faculty.id)}"
+              ${section && section.adviserId === faculty.id ? 'selected' : ''}
+            >${esc(faculty.name)}</option>
+          `).join('');
+
+      $('secf-err').textContent = '';
+      $('secf-err').classList.add('hidden');
+      $('section-form').classList.remove('hidden');
+      tab('sections');
+      window.scrollTo({ top: 0, behavior: 'smooth' });
+    }
+
+    function closeSection() {
+      $('section-form').classList.add('hidden');
+      secEditing = null;
+    }
+
+    function saveSection() {
+      const name = $('secf-name').value.trim();
+      const adviserId = $('secf-adviser').value
+        ? Number($('secf-adviser').value)
+        : null;
+
+      const fail = text => {
+        $('secf-err').textContent = text;
+        $('secf-err').classList.remove('hidden');
+      };
+
+      if (!name) return fail('Section name is required.');
+
+      if (db.sections.some(section =>
+        section.name.toLowerCase() === name.toLowerCase() &&
+        section.id !== secEditing
+      )) {
+        return fail('A section with that name already exists.');
+      }
+
+      if (secEditing === null) {
+        db.sections.push({
+          id: Date.now(),
+          name,
+          adviserId,
+          studentIds: []
+        });
+      } else {
+        Object.assign(
+          db.sections.find(item => item.id === secEditing),
+          { name, adviserId }
+        );
+      }
+
+      if (!DB.save(db)) {
+        return fail('Could not save the section to Supabase.');
+      }
+
+      closeSection();
+      draw();
+    }
+
+    function delSection(id) {
+      const section = db.sections.find(item => item.id === id);
+
+      if (!section) return;
+
+      const count = Sections.count(db, section);
+
+      const confirmed = confirm(
+        `Delete section ${section.name}?` +
+        (count
+          ? `\n\n${count} student(s) in it will become unassigned.`
+          : '')
+      );
+
+      if (!confirmed) return;
+
+      db.sections = db.sections.filter(item => item.id !== id);
+
+      if (!DB.save(db)) {
+        alert('Could not save changes to Supabase.');
+        return;
+      }
+
+      draw();
+    }
+
+    function setSection(studentId, value) {
+      Sections.assign(db, studentId, value ? Number(value) : null);
+
+      if (!DB.save(db)) {
+        alert('Could not save changes to Supabase.');
+      }
+
+      draw();
+    }
+
